<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<application>
		<!-- OkHttp's startup initializer detects the platform on the main thread before Application.onCreate():
		OkHttpInitializer replaces it and gives OkHttp its context from a background thread -->
		<provider
			android:name="androidx.startup.InitializationProvider"
			android:authorities="${applicationId}.androidx-startup"
			android:exported="false"
			tools:node="merge">
			<meta-data
				android:name="okhttp3.internal.platform.PlatformInitializer"
				tools:node="remove" />
			<meta-data
				android:name="ovh.karewan.knhttp.internal.OkHttpInitializer"
				android:value="androidx.startup" />
		</provider>
	</application>

</manifest>
